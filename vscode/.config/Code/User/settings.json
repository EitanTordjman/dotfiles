{
    "editor.fontSize": 15,
    "terminal.integrated.fontSize": 14,
    "terminal.integrated.defaultProfile.osx": "fish",
    "workbench.colorTheme": "Catppuccin Mocha",
    "workbench.colorCustomizations": {
        "terminal.background": "#00000000"
    },
    "window.titleBarStyle": "custom",
    "vscode_vibrancy.preferedDarkTheme": "Catppuccin Mocha",
    "vscode_vibrancy.theme": "Catppuccin Mocha",
    "terminal.integrated.gpuAcceleration": "off",
    "window.systemColorTheme": "dark",
    "window.autoDetectColorScheme": false,
    "vscode_vibrancy.imports": [
        "/path/to/file"
    ],
    "python.analysis.typeCheckingMode": "strict",
    "editor.fontFamily": "CaskaydiaCove Nerd Font",
    "terminal.integrated.fontFamily": "CaskaydiaCove Nerd Font",
    "terminal.integrated.fontLigatures.enabled": true,
    "claudeCode.preferredLocation": "panel",
    "claudeCode.selectedModel": "claude-sonnet-4-6",
    "security.promptForLocalFileProtocolHandling": false,
    "explorer.confirmDragAndDrop": false,
    "workbench.editorAssociations": {
        "*.md": "markdownEditorOptimized.editor",
        "git:**/*.md": "default",
        "git:/**/*.md": "default",
        "chat-editing-text-model:**/*.md": "default",
        "chat-editing-text-model:/**/*.md": "default",
        "*.markdown": "markdownEditorOptimized.editor",
        "git:**/*.markdown": "default",
        "git:/**/*.markdown": "default",
        "chat-editing-text-model:**/*.markdown": "default",
        "chat-editing-text-model:/**/*.markdown": "default",
        "*.mdx": "markdownEditorOptimized.editor",
        "git:**/*.mdx": "default",
        "git:/**/*.mdx": "default",
        "chat-editing-text-model:**/*.mdx": "default",
        "chat-editing-text-model:/**/*.mdx": "default",
        "*.mdc": "markdownEditorOptimized.editor",
        "git:**/*.mdc": "default",
        "git:/**/*.mdc": "default",
        "chat-editing-text-model:**/*.mdc": "default",
        "chat-editing-text-model:/**/*.mdc": "default"
    },
    "markdownEditorOptimized.lineNumbers.visible": true,
    "markdownEditorOptimized.gitChanges.visible": true,
    "markdownEditorOptimized.theme.base02": "#7f849c",
    "markdownEditorOptimized.theme.base03": "#45475a",
    "markdownEditorOptimized.theme.base04": "#cba6f7",
    "markdownEditorOptimized.theme.base05": "#89b4fa",
    "markdownEditorOptimized.theme.base06": "#89dceb",
    "markdownEditorOptimized.theme.base07": "#f9e2af",
    "markdownEditorOptimized.theme.base08": "#fab387",
    "markdownEditorOptimized.theme.base09": "#a6e3a1",
    "git.confirmSync": false,
    "git.enableSmartCommit": true
}